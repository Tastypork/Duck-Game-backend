# Copy to .env and adjust. Default port 19999 is a high port; override PORT if it is still taken.
#
# If the API runs from systemd and still shows discord_oauth_configured: false, set this in the unit
# to an absolute path: Environment="DUCK_GAME_BACKEND_ENV_FILE=/opt/Duck-Game-backend/.env"
# DUCK_GAME_BACKEND_ENV_FILE=

PORT=19999
DATABASE_URL=postgresql+psycopg://duck:duck@localhost:5432/duckgame
PUBLIC_BASE_URL=https://api.duckgame.app
# Duck API: GET returns JSON {"url": "<image link>"} — backend stores that link for embeds.
# DUCK_IMAGE_API_URL=https://duck.jocal.dev/duck
# Optional comma-separated hostnames for GET /v1/image-proxy (defaults include Discord CDNs + hosts from URLs above).
# IMAGE_PROXY_ALLOWED_HOSTS=
# API_PREFIX=
# DASHBOARD_BASE_URL=https://api.duckgame.app/user
# Where GET /user/{id} writes generated HTML before serving (default: package static/user_html).
# USER_HTML_DIR=
#
# --- Discord OAuth (required for POST /oauth/token and /oauth/discord/profile) ---
# Copy Client ID + Client Secret from Developer Portal → your app → OAuth2.
# Must be the SAME application as VITE_DISCORD_CLIENT_ID in Duck-Game/apps/activity-client.
# After editing, restart uvicorn/systemd so the process picks up env.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Same bot as Fishin-Tiffin / Discord adapter — used to list servers the bot shares with the user (web login).
# DISCORD_BOT_TOKEN=
#
# Bot poll relay (optional): BOT_SHARED_SECRET=...
